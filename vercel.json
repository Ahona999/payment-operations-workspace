{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/exceptions", "destination": "/index.html" },
    { "source": "/investigations", "destination": "/index.html" },
    { "source": "/investigations/:caseId", "destination": "/index.html" },
    { "source": "/reconciliation", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" }
  ]
}
